index f9070736..8827ea1e 100644
--- a/DesktopEditor/graphics/pro/metafile.pri
+++ b/DesktopEditor/graphics/pro/metafile.pri
@@ -151,6 +151,13 @@ METAFILE_PATH = $$PWD/../../raster/Metafile
 
 		CONFIG += css_calculator_without_xhtml
 
+		# Static (wasm) link: the sources of the CSS calculator are not compiled into this library (the Dockerfile
