+		# and every metafile (WMF/EMF/SVG) corrupts the heap.
+		DEFINES += CSS_CALCULATOR_WITH_XHTML
+
 		include($$METAFILE_PATH/../../../Common/3dParty/html/css/CssCalculator.pri)
 	}
